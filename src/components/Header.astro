---
import HeaderLink from "./HeaderLink.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header
	class="bg-gray-950 shadow-lg sticky top-0 z-[60] border-b border-indigo-500/20"
	data-pagefind-ignore
>
	<div class="max-w-[1600px] mx-auto px-4 lg:px-8">
		<div class="flex justify-between items-center h-16">
			<div class="flex-shrink-0 flex items-center pr-4">
				<a href={`${base}/`} class="flex items-center gap-3 group">
					<img
						src={`${base}/logo-himo.png`}
						alt="HiMô Logo"
						class="h-10 w-auto rounded-lg shadow-neon group-hover:scale-110 transition-transform duration-300"
					/>
					<div class="flex flex-col leading-none">
						<span
							class="text-xl font-bold tracking-tighter text-indigo-300 group-hover:text-indigo-600 transition-colors"
							>HiMô</span
						>
						<span
							class="text-[10px] uppercase tracking-[0.2em] text-indigo-300/70 font-medium whitespace-nowrap"
							>Nguyễn Văn Hoàng</span
						>
					</div>
				</a>
			</div>
			<!-- Desktop Navigation -->
			<nav class="hidden md:flex space-x-6 items-center">
				<HeaderLink
					href={`${base}/`}
					class="text-gray-300 hover:text-indigo-400 font-medium transition-colors"
					>Trang chủ</HeaderLink
				>
				<HeaderLink
					href={`${base}/projects`}
					class="text-gray-300 hover:text-indigo-400 font-medium transition-colors"
					>Dự án</HeaderLink
				>
				<HeaderLink
					href={`${base}/blog`}
					class="text-gray-300 hover:text-indigo-400 font-medium transition-colors"
					>Kiến thức</HeaderLink
				>
				<HeaderLink
					href={`${base}/learn`}
					class="text-gray-300 hover:text-indigo-400 font-medium transition-colors"
					>Học tập</HeaderLink
				>
				<HeaderLink
					href={`${base}/notes`}
					class="text-gray-300 hover:text-indigo-400 font-medium transition-colors"
					>Ghi chú</HeaderLink
				>
				<HeaderLink
					href={`${base}/playground`}
					class="text-gray-300 hover:text-indigo-400 font-medium transition-colors"
					>🎮 Lab</HeaderLink
				>
				<div
					class="relative group flex items-center justify-end bg-transparent rounded-full border border-transparent hover:border-indigo-100 transition-all focus-within:border-indigo-500 ml-4"
				>
					<input
						type="text"
						id="desktop-search-input"
						placeholder="Nhập để tìm kiếm..."
						class="w-0 opacity-0 px-0 py-1.5 focus:w-56 focus:opacity-100 focus:px-4 focus:bg-gray-900/80 group-hover:w-56 group-hover:opacity-100 group-hover:px-4 group-hover:bg-gray-900/80 transition-all duration-300 rounded-l-full outline-none text-sm z-10 bg-transparent placeholder-indigo-400/50 text-indigo-100 border-none cursor-text"
					/>
					<button
						id="desktop-search-btn"
						class="p-2 text-gray-400 group-hover:text-indigo-400 rounded-r-full transition-colors z-20 focus:outline-none"
						title="Tìm kiếm"
					>
						<svg
							class="w-5 h-5"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
							></path></svg
						>
					</button>
				</div>
			</nav>

			<!-- Mobile Right Items -->
			<div class="flex md:hidden items-center space-x-2">
				<div class="relative flex items-center justify-end w-8 h-8">
					<input
						type="text"
						id="mobile-search-input"
						placeholder="Tìm kiếm..."
						class="absolute right-0 w-8 opacity-0 focus:w-[150px] focus:opacity-100 px-4 py-1.5 pr-8 bg-gray-900 border border-indigo-500/30 focus:border-indigo-400 focus:shadow-neon transition-all duration-300 rounded-full outline-none text-sm z-40 placeholder-gray-500 text-indigo-100 overflow-hidden"
					/>
					<button
						id="mobile-search-btn"
						class="absolute right-0 p-1.5 text-gray-400 hover:text-indigo-400 rounded-full transition-colors z-50 bg-transparent border-none focus:outline-none"
						title="Tìm kiếm"
					>
						<svg
							class="w-5 h-5"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
							></path></svg
						>
					</button>
				</div>
			</div>
		</div>
	</div>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
