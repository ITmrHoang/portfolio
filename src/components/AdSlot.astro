---
/**
 * AdSlot — Component quảng cáo tái sử dụng
 * Hỗ trợ 3 kiểu: sidebar (dọc), inline (trong bài), banner (ngang cuối bài)
 * Khi chưa có Adsense, hiển thị placeholder đẹp
 */
interface Props {
  type?: 'sidebar' | 'inline' | 'banner';
  /** Google Adsense ad slot ID (để trống = placeholder) */
  adSlot?: string;
  /** Custom class */
  class?: string;
}

const { type = 'sidebar', adSlot, class: className } = Astro.props;

// Cấu hình theo loại
const config = {
  sidebar: {
    height: 'h-[500px]',
    label: 'Quảng cáo',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  inline: {
    height: 'h-[120px]',
    label: 'Quảng cáo tài trợ',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  banner: {
    height: 'h-[100px]',
    label: 'Banner quảng cáo',
    icon: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z',
  },
};

const { height, label, icon } = config[type];
---

<div
  class:list={[
    'ad-slot group relative overflow-hidden rounded-xl transition-all duration-300',
    height,
    type === 'sidebar' && 'sticky top-24',
    className,
  ]}
  data-ad-type={type}
  data-pagefind-ignore
>
  {adSlot ? (
    <!-- Slot Adsense thật -->
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-XXXXXXXX"
      data-ad-slot={adSlot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
  ) : (
    <!-- Placeholder đẹp khi chưa có Adsense -->
    <div class="ad-placeholder w-full h-full flex flex-col items-center justify-center text-center p-4 bg-gradient-to-br from-indigo-50/80 via-purple-50/40 to-blue-50/80 border-2 border-dashed border-indigo-200/60 rounded-xl hover:border-indigo-300/80 transition-all duration-300">
      <!-- Animated icon -->
      <div class="relative mb-3">
        <div class="absolute inset-0 bg-indigo-400/20 rounded-full blur-lg animate-pulse"></div>
        <div class="relative bg-white/80 backdrop-blur-sm rounded-full p-3 shadow-sm border border-indigo-100">
          <svg
            class="w-6 h-6 text-indigo-400 group-hover:text-indigo-500 transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d={icon}
            />
          </svg>
        </div>
      </div>

      <span class="text-[11px] font-semibold uppercase tracking-[0.15em] text-indigo-400/80">
        {label}
      </span>

      {type === 'sidebar' && (
        <p class="mt-2 text-[10px] text-indigo-300/70 leading-relaxed max-w-[120px]">
          Liên hệ hợp tác quảng cáo
        </p>
      )}
    </div>
  )}
</div>

<style>
  .ad-slot {
    /* Micro-animation nhẹ khi hover */
    &:hover .ad-placeholder {
      background: linear-gradient(135deg, 
        rgba(238, 242, 255, 0.9) 0%, 
        rgba(245, 243, 255, 0.6) 50%, 
        rgba(239, 246, 255, 0.9) 100%
      );
    }
  }
</style>
