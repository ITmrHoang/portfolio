---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!-- Curved Magic Menu (Mobile) -->
<div class="magic-nav z-50 md:!hidden" data-pagefind-ignore>
    <ul class="magic-nav-list">
        <div id="magic-indicator" class="magic-indicator"></div>
        <li class="magic-nav-item active" data-path={`${base}/`}>
            <a href={`${base}/`}>
                <span class="icon">
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                        ></path>
                    </svg>
                </span>
                <span class="text">Trang chủ</span>
            </a>
        </li>
        <li class="magic-nav-item" data-path={`${base}/projects`}>
            <a href={`${base}/projects`}>
                <span class="icon">
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path>
                    </svg>
                </span>
                <span class="text">Dự án</span>
            </a>
        </li>
        <li class="magic-nav-item" data-path={`${base}/blog`}>
            <a href={`${base}/blog`}>
                <span class="icon">
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
                        ></path>
                    </svg>
                </span>
                <span class="text">Blog</span>
            </a>
        </li>
        <li class="magic-nav-item" data-path={`${base}/learn`}>
            <a href={`${base}/learn`}>
                <span class="icon">
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                        ></path>
                    </svg>
                </span>
                <span class="text">Học tập</span>
            </a>
        </li>
        <li class="magic-nav-item" data-path={`${base}/notes`}>
            <a href={`${base}/notes`}>
                <span class="icon">
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 012.828 0L20.586 6a2 2 0 010 2.828l-9.9 9.9-4.242.707.707-4.242 9.9-9.9z"
                        ></path>
                    </svg>
                </span>
                <span class="text">Ghi chú</span>
            </a>
        </li>
    </ul>
</div>

<style is:global>
    /* --- SLIM MAGIC MENUBAR CSS (CODEHAL PATTERN FIX) --- */
    .magic-nav {
        position: fixed;
        bottom: 0;
        width: 100%;
        height: 50px; /* Nhỏ gọn hơn */
        background: linear-gradient(
            135deg,
            #fdfbfb 0%,
            #f3f4f6 100%
        ); /* Nền Gradient Sinh động */
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 12px 12px 0 0;
        box-shadow: 0 -5px 15px rgba(0, 0, 0, 0.05);
    }
    .magic-nav-list {
        display: flex;
        width: 100%;
        max-width: 450px;
        position: relative;
        justify-content: space-around;
    }
    .magic-nav-item {
        position: relative;
        list-style: none;
        width: 50px;
        height: 50px;
        z-index: 10;
    }
    .magic-nav-item a {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        width: 100%;
        text-align: center;
        font-weight: 500;
        height: 100%;
    }
    .magic-nav-item .icon {
        position: absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: 0.5s;
        width: 100%;
        height: 50px; /* Center SVG perfectly inside the 50px block */
        color: #9ca3af; /* Gray-400 */
    }
    /* Kéo icon lên khi Active */
    .magic-nav-item.active .icon {
        transform: translateY(
            -25px
        ); /* Khớp tuyệt đối với tâm của Indicator width 50 */
        color: var(--active-color, #ffff);
    }
    .magic-nav-item .text {
        position: absolute;
        color: var(--active-color, #4f46e5);
        font-size: 0.6em;
        letter-spacing: 0.05em;
        transition: 0.5s;
        opacity: 0;
        transform: translateY(20px);
        font-weight: bold;
    }
    .magic-nav-item.active .text {
        opacity: 1;
        transform: translateY(12px);
    }

    .magic-indicator {
        position: absolute;
        top: -50%;
        left: 0; /* THÊM left:0 ĐỂ TRÁNH LỖI VỊ TRÍ FLEXBOX */
        width: 50px;
        height: 50px;
        background: linear-gradient(
            135deg,
            #ffffff 0%,
            #f8fafc 100%
        ); /* Nền nhạt bên trong viên nang */
        border-radius: 50%;
        border: 4px solid var(--active-color, #ffff); /* Viền màu động ôm trọn vòm */
        transition: 0.5s cubic-bezier(0.68, -0.55, 0.26, 1.55);
    }
    /* Cánh vòm bên trái (Wing Effect) */
    .magic-indicator::before {
        content: "";
        position: absolute;
        top: 50%;
        left: -18px;
        width: 15px;
        height: 15px;
        background: transparent;
        border-top-right-radius: 15px;
        box-shadow: 0px -4px 1px -1px var(--active-color, #ffff);
    }
    /* Cánh vòm bên phải (Wing Effect) */
    .magic-indicator::after {
        content: "";
        position: absolute;
        top: 50%;
        right: -18px;
        width: 15px;
        height: 15px;
        background: transparent;
        border-top-left-radius: 15px;
        box-shadow: 0px -4px 1px -1px var(--active-color, #ffff);
    }
</style>
