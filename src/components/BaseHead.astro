---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/images/fallback-image.png';
import { BUILD_ID, FAVICON_SCHEDULE, SITE_AUTHOR, SITE_DESCRIPTION, SITE_LANG, SITE_TITLE } from '../consts';
import { withBase } from '../utils/site';

export interface SeoProps {
	title: string;
	description?: string;
	/** Ảnh chia sẻ: ảnh import (ImageMetadata) hoặc đường dẫn /uploads/... / URL tuyệt đối */
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
}
type Props = SeoProps;

const {
	title,
	description = SITE_DESCRIPTION,
	image = FallbackImage,
	type = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const fullTitle = `${title} | ${SITE_TITLE}`;
const faviconSchedule = FAVICON_SCHEDULE.map((s) => ({ ...s, icon: `${withBase(s.icon)}?v=${BUILD_ID}` }));
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageSrc = typeof image === 'string' ? withBase(image) ?? image : image.src;
const imageURL = new URL(imageSrc, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- ?v=BUILD_ID: thay file icon rồi deploy là trình duyệt tải icon mới (favicon bị cache rất lâu) -->
<link rel="icon" type="image/png" href={`${base}/favicon.png?v=${BUILD_ID}`} />
<link rel="icon" href={`${base}/favicon.ico?v=${BUILD_ID}`} />
<!-- Đổi favicon theo ngày — cấu hình FAVICON_SCHEDULE trong src/consts.ts -->
<script is:inline define:vars={{ schedule: faviconSchedule }}>
	const now = new Date();
	const md = String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
	const hit = schedule.find((s) => (s.from <= s.to ? md >= s.from && md <= s.to : md >= s.from || md <= s.to));
	if (hit) {
		document.querySelectorAll('link[rel~="icon"]').forEach((l) => l.remove());
		const link = document.createElement('link');
		link.rel = 'icon';
		link.href = hit.icon;
		document.head.appendChild(link);
	}
</script>
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={`${base}/rss.xml`} />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href={`${base}/fonts/atkinson-regular.woff`} as="font" type="font/woff" crossorigin />
<link rel="preload" href={`${base}/fonts/atkinson-bold.woff`} as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />

<!-- Open Graph (Facebook, Zalo, LinkedIn...) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_LANG === 'vi' ? 'vi_VN' : SITE_LANG} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={SITE_AUTHOR} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- PWA -->
<link rel="manifest" href={`${base}/manifest.json`} />
<meta name="theme-color" content="#4f46e5" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="HiMo" />
<link rel="apple-touch-icon" href={`${base}/favicon.png`} />
