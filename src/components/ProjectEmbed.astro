---
// Nhúng trang demo của dự án bằng iframe.
// - Trang trong chính site này (đường dẫn bắt đầu bằng "/"): luôn nhúng được.
// - Trang ngoài (https://...): chỉ hiện được nếu trang đó KHÔNG chặn nhúng
//   (header X-Frame-Options: DENY/SAMEORIGIN hoặc CSP frame-ancestors). Phải là https.
import { isExternal, withBase } from '../utils/site';

interface Props {
  url: string;
  title: string;
  height?: number;
}
const { url, title, height = 720 } = Astro.props;
const src = withBase(url) ?? url;
const external = isExternal(url);
---

<section class="project-embed mb-12 rounded-2xl overflow-hidden shadow-xl border border-gray-200 bg-white">
  <div class="flex items-center gap-3 px-4 py-2.5 bg-gray-100 border-b border-gray-200">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="w-3 h-3 rounded-full bg-red-400"></span>
      <span class="w-3 h-3 rounded-full bg-amber-400"></span>
      <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
    </span>
    <span class="flex-grow min-w-0 truncate text-xs text-gray-500 bg-white rounded-md px-3 py-1 border border-gray-200">{external ? url : `${Astro.site?.origin ?? ''}${src}`}</span>
    <button type="button" data-embed-fullscreen class="text-gray-500 hover:text-indigo-600 p-1" title="Toàn màn hình" aria-label="Toàn màn hình">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/></svg>
    </button>
    <a href={src} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} class="text-gray-500 hover:text-indigo-600 p-1" title="Mở trang" aria-label="Mở trang">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
    </a>
  </div>
  <iframe
    src={src}
    title={`Demo: ${title}`}
    loading="lazy"
    style={`height:${height}px`}
    class="w-full block bg-white max-h-[80vh]"
    allow="fullscreen; clipboard-write"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
  {external && (
    <p class="px-4 py-2 text-xs text-gray-500 bg-gray-50 border-t border-gray-100">
      Khung trống? Trang này có thể chặn nhúng — <a href={src} target="_blank" rel="noopener" class="text-indigo-600 hover:underline">mở trong tab mới ↗</a>
    </p>
  )}
</section>

<script is:inline>
  document.querySelectorAll('[data-embed-fullscreen]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = btn.closest('.project-embed')?.querySelector('iframe');
      frame?.requestFullscreen?.();
    });
  });
</script>
