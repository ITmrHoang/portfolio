---
import Layout from '../../layouts/Layout.astro';
import PostCover from '../../components/PostCover.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Comments from '../../components/Comments.astro';
import { getCollection } from 'astro:content';
import mdxComponents from '../../components/mdxComponents';
import { BASE, readingTime } from '../../utils/site';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, all: entries },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await entry.render();
const minutes = readingTime(entry.body);

// Bài liên quan: nhiều tag chung nhất, sau đó bài mới hơn
const related = all
  .filter((p) => p.slug !== entry.slug)
  .map((p) => ({ post: p, score: p.data.tags.filter((t) => entry.data.tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 3)
  .map((r) => r.post);

const pageURL = new URL(Astro.url.pathname, Astro.site).href;

const components = mdxComponents;
---

<Layout
  title={entry.data.title}
  description={entry.data.excerpt}
  image={entry.data.coverImage}
  type="article"
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updatedDate}
  tags={entry.data.tags}
>
  <ReadingProgress target="post-content" />

  <article class="max-w-5xl w-full mx-auto py-6 px-4 sm:px-6">
    <header class="mb-10 text-center">
      {entry.data.tags.length > 0 && (
        <div class="flex flex-wrap justify-center gap-2 mb-5">
          {entry.data.tags.map((t) => (
            <a href={`${BASE}/blog?tag=${encodeURIComponent(t)}`} class="px-3 py-1 rounded-full text-sm font-medium bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition-colors">#{t}</a>
          ))}
        </div>
      )}
      <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-5 leading-tight">{entry.data.title}</h1>
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-gray-500">
        <time datetime={entry.data.date.toISOString()}>📅 {entry.data.date.toLocaleDateString('vi-VN')}</time>
        {entry.data.updatedDate && (
          <time datetime={entry.data.updatedDate.toISOString()} class="text-emerald-600">🔄 Cập nhật {entry.data.updatedDate.toLocaleDateString('vi-VN')}</time>
        )}
        <span>📖 {minutes} phút đọc</span>
      </div>
    </header>

    <div class="rounded-3xl overflow-hidden shadow-lg border border-gray-100 mb-10">
      <PostCover title={entry.data.title} src={entry.data.coverImage} tag={entry.data.tags[0]} class="aspect-[2/1] max-h-[420px]" />
    </div>

    <div id="post-content" class="prose prose-lg prose-indigo mx-auto text-gray-800 max-w-none">
      <!-- Astro's built-in MDX renderer -->
      <Content components={components} />
    </div>

    {related.length > 0 && (
      <section class="mt-16 border-t border-gray-100 pt-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Bài viết liên quan</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {related.map((p) => (
            <a href={`${BASE}/blog/${p.slug}`} class="group block bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
              <PostCover title={p.data.title} src={p.data.coverImage} class="h-28 text-sm" />
              <div class="p-4">
                <p class="font-semibold text-gray-900 leading-snug line-clamp-2 group-hover:text-indigo-600 transition-colors">{p.data.title}</p>
                <p class="text-xs text-gray-500 mt-2">{p.data.date.toLocaleDateString('vi-VN')} · {readingTime(p.body)} phút đọc</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <Comments url={pageURL} title={entry.data.title} />

    <div class="mt-16 text-center border-t border-gray-100 pt-8">
      <a href={`${BASE}/blog`} class="text-indigo-600 hover:underline font-medium">← Quay lại danh sách bài viết</a>
    </div>
  </article>
</Layout>
