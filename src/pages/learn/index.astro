---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const allLearn = await getCollection('learn');

// Gom nhóm thông tin Thể loại (Category)
interface CategorySummary {
  id: string;
  title: string;
  order: number;
  description: string;
  lessonCount: number;
  firstSlug: string;
}

const categoryMap = new Map<string, CategorySummary>();

allLearn.forEach((entry: any) => {
  const parts = entry.slug.split('/');
  const catId = parts[0].toLowerCase();
  
  const catTitle = entry.data.categoryTitle || catId.toUpperCase();
  const catOrder = entry.data.categoryOrder ?? 99;
  const desc = entry.data.description || `Tổng hợp lý thuyết và bài thực hành chi tiết về ${catTitle}.`;

  if (!categoryMap.has(catId)) {
    categoryMap.set(catId, {
      id: catId,
      title: catTitle,
      order: catOrder,
      description: desc,
      lessonCount: 0,
      firstSlug: entry.slug,
    });
  }

  const cat = categoryMap.get(catId)!;
  if (entry.data.categoryTitle) cat.title = entry.data.categoryTitle;
  if (entry.data.categoryOrder !== undefined && entry.data.categoryOrder < cat.order) {
    cat.order = entry.data.categoryOrder;
  }
  cat.lessonCount += 1;
});

const categories = Array.from(categoryMap.values()).sort((a, b) => a.order - b.order);

// Icon màu sắc cho từng category
const categoryTheme: Record<string, { gradient: string; border: string; badgeBg: string; textAccent: string }> = {
  java: {
    gradient: 'from-amber-500/20 via-orange-500/10 to-transparent',
    border: 'border-amber-500/30 group-hover:border-amber-400',
    badgeBg: 'bg-amber-500/20 text-amber-300 border-amber-500/40',
    textAccent: 'text-amber-400',
  },
  javascript: {
    gradient: 'from-yellow-500/20 via-amber-500/10 to-transparent',
    border: 'border-yellow-500/30 group-hover:border-yellow-400',
    badgeBg: 'bg-yellow-500/20 text-yellow-300 border-yellow-500/40',
    textAccent: 'text-yellow-400',
  },
  js: {
    gradient: 'from-yellow-500/20 via-amber-500/10 to-transparent',
    border: 'border-yellow-500/30 group-hover:border-yellow-400',
    badgeBg: 'bg-yellow-500/20 text-yellow-300 border-yellow-500/40',
    textAccent: 'text-yellow-400',
  },
  python: {
    gradient: 'from-blue-500/20 via-indigo-500/10 to-transparent',
    border: 'border-blue-500/30 group-hover:border-blue-400',
    badgeBg: 'bg-blue-500/20 text-blue-300 border-blue-500/40',
    textAccent: 'text-blue-400',
  },
  rust: {
    gradient: 'from-orange-600/20 via-amber-600/10 to-transparent',
    border: 'border-orange-500/30 group-hover:border-orange-400',
    badgeBg: 'bg-orange-500/20 text-orange-300 border-orange-500/40',
    textAccent: 'text-orange-400',
  },
  default: {
    gradient: 'from-indigo-500/20 via-purple-500/10 to-transparent',
    border: 'border-indigo-500/30 group-hover:border-indigo-400',
    badgeBg: 'bg-indigo-500/20 text-indigo-300 border-indigo-500/40',
    textAccent: 'text-indigo-400',
  },
};
---

<Layout title="Góc Học Tập - Danh Mục Bài Học">
  <div class="max-w-6xl mx-auto py-6">
    <!-- Header Section -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 mb-3">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        Hệ Thống Kiến Thức
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
        Chọn Thể Loại Bạn Muốn Học
      </h1>
      <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
        Các lộ trình bài học được phân loại rõ ràng theo từng ngôn ngữ và chủ đề công nghệ. Chọn một danh mục để bắt đầu.
      </p>
    </div>

    <!-- Category Grid -->
    {categories.length === 0 ? (
      <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-gray-300">
        <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <p class="text-gray-500 font-medium">Chưa có chủ đề học nào được tạo.</p>
        <p class="text-xs text-gray-400 mt-1">Hãy thêm file `.mdx` vào thư mục `src/content/learn/` để bắt đầu!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => {
          const theme = categoryTheme[cat.id] || categoryTheme.default;

          return (
            <aside class="relative">
            <a
              href={`${base}/learn/${cat.firstSlug}`}
              class={`group relative bg-gray-950 rounded-2xl p-6 border transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl overflow-hidden flex flex-col justify-between h-full ${theme.border}`}
            >
              <!-- Background Gradient Glow -->
              <div class={`absolute inset-0 bg-gradient-to-br ${theme.gradient} opacity-40 group-hover:opacity-80 transition-opacity`}></div>

              <div class="relative z-10">
                <!-- Top Badge & Icon -->
                <div class="flex items-center justify-between mb-4">
                  <span class={`inline-block px-2.5 py-0.5 rounded-md text-[11px] font-bold tracking-wider uppercase border ${theme.badgeBg}`}>
                    {cat.id}
                  </span>
                  <span class="text-xs text-gray-400 flex items-center gap-1 font-medium bg-gray-900/80 px-2.5 py-1 rounded-full border border-gray-800">
                    <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    {cat.lessonCount} bài học
                  </span>
                </div>

                <!-- Title & Description -->
                <h2 class={`text-xl font-bold text-white mb-2 transition-colors ${theme.textAccent}`}>
                  {cat.title}
                </h2>
                <p class="text-gray-400 text-xs sm:text-sm line-clamp-3 leading-relaxed mb-6">
                  {cat.description}
                </p>
              </div>

              <!-- Bottom CTA Button -->
              <div class="relative z-10 pt-4 border-t border-gray-800/80 flex items-center justify-between text-xs font-semibold text-gray-300 group-hover:text-white transition-colors">
                <span>Vào học ngay</span>
                <div class="w-7 h-7 rounded-full bg-gray-800 group-hover:bg-indigo-600 flex items-center justify-center transition-colors shadow-sm">
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-white group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </div>
              </div>
            </a>
            </aside>
          );
        })}
      </div>
    )}
  </div>
</Layout>
