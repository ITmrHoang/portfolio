---
import Layout from "../../layouts/Layout.astro";
import LearnSidebar from "../../components/LearnSidebar.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const learnEntries = await getCollection("learn");
  return learnEntries.map((entry: any) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry }: any = Astro.props;
const { Content } = await entry.render();
import mdxComponents from "../../components/mdxComponents";

const parts = entry.slug.split("/");
const category = parts[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title={`${entry.data.title} - Góc Học Tập`}>
  <div
    class="max-w-[1600px] mx-auto flex flex-col lg:flex-row gap-8 py-4 sm:py-6"
  >
    <!-- Sidebar Menu Bên Trái (Lọc theo Category của bài học) -->
    <LearnSidebar category={category} currentSlug={entry.slug} />

    <!-- Khung Nội Dung Bài Học Bên Phải -->
    <main
      class="flex-1 min-w-0 bg-white rounded-2xl p-6 sm:p-10 border border-gray-200/80 shadow-sm"
    >
      <!-- Breadcrumb Navigation -->
      <nav
        class="flex items-center gap-2 text-xs text-gray-500 mb-6 flex-wrap font-medium"
      >
        <a
          href={`${base}/learn`}
          class="hover:text-indigo-600 transition-colors flex items-center gap-1"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            ></path>
          </svg>
          Học tập
        </a>
        <span>/</span>
        <span class="font-bold text-indigo-600 uppercase tracking-wide"
          >{entry.data.categoryTitle || category}</span
        >
        {
          entry.data.sessionTitle && (
            <>
              <span>/</span>
              <span class="text-gray-700">{entry.data.sessionTitle}</span>
            </>
          )
        }
      </nav>

      <!-- Tiêu đề & Mô tả bài viết -->
      <header class="mb-8 pb-6 border-b border-gray-100">
        <h1
          class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3 leading-snug"
        >
          {entry.data.title}
        </h1>
        {
          entry.data.description && (
            <p class="text-gray-600 text-sm sm:text-base leading-relaxed bg-indigo-50/50 p-4 rounded-xl border border-indigo-100/80">
              {entry.data.description}
            </p>
          )
        }
      </header>

      <!-- Nội dung Markdown / MDX -->
      <article
        class="prose prose-indigo max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-indigo-600 prose-img:rounded-xl prose-pre:bg-gray-900 prose-pre:shadow-lg"
      >
        <Content components={mdxComponents} />
      </article>
    </main>
  </div>
</Layout>
