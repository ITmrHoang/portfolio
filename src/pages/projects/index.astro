---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { isExternal, withBase } from '../../utils/site';

const allProjects = await getCollection('projects');
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Dự án nổi bật">
  <div class="w-full mx-auto py-12 px-4 sm:px-6">
    <header class="mb-12 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">Dự án của tôi</h1>
      <p class="mt-4 text-xl text-gray-500">Những sản phẩm chất lượng tôi đã tham gia và phát triển.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allProjects.length === 0 ? (
        <p class="text-gray-500 col-span-full text-center">Chưa có dự án nào.</p>
      ) : (
        allProjects.map((project) => (
          <div class="bg-white flex flex-col rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
            {project.data.coverImage && (
              <img src={withBase(project.data.coverImage)} alt={project.data.title} class="w-full h-48 object-cover" />
            )}
            <div class="p-6 flex-grow flex flex-col">
              <h2 class="text-xl font-bold text-gray-900 mb-2">{project.data.title}</h2>
              <p class="text-gray-600 mb-4 flex-grow line-clamp-3">{project.data.description}</p>
              
              {project.data.technologies && project.data.technologies.length > 0 && (
                <div class="mb-4 flex flex-wrap gap-2">
                  {project.data.technologies.slice(0, 3).map((tech) => (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                      {tech}
                    </span>
                  ))}
                  {project.data.technologies.length > 3 && (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      +{project.data.technologies.length - 3}
                    </span>
                  )}
                </div>
              )}
              
              <div class="mt-auto flex items-center justify-between gap-3">
                <a href={`${base}/projects/${project.slug}`} class="text-indigo-600 font-semibold hover:text-indigo-800 inline-flex items-center">
                  Xem chi tiết
                  <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
                {project.data.demo && (
                  isExternal(project.data.demo) ? (
                    <a href={project.data.demo} target="_blank" rel="noopener" class="text-sm font-medium text-gray-500 hover:text-indigo-600">Mở trang ↗</a>
                  ) : (
                    <a href={withBase(project.data.demo)} class="text-sm font-medium text-gray-500 hover:text-indigo-600">Mở trang →</a>
                  )
                )}
              </div>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</Layout>
