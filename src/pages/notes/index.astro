---
import NotesLayout from '../../layouts/NotesLayout.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getCollection } from 'astro:content';
import { BASE, LEVEL_STYLES, groupNotes } from '../../utils/site';

const notes = await getCollection('notes');
// Nhóm theo chủ đề (TOPIC_ORDER) → cấp độ; trong mỗi nhóm bài mới nhất lên đầu
const topics = groupNotes(notes);
---

<NotesLayout title="Sổ tay ghi chú">
  <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-gray-100 h-full">
    <header class="mb-8 border-b border-gray-100 pb-8 text-center md:text-left">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-4 text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">
        Sổ tay của tôi
      </h1>
      <p class="text-lg text-gray-500">Nơi chắt lọc những kiến thức và thủ thuật lập trình đắt giá nhất.</p>
      <p class="text-sm text-gray-400 mt-2">Tổng cộng {notes.length} bài viết</p>
    </header>

    <TagFilter items={notes.map((n) => n.data)} />

    {topics.map(({ topic, count, levels }, index) => (
      <details class="mb-6 group/topic border border-gray-100 rounded-2xl overflow-hidden" open={index === 0 || undefined} data-tag-group>
        <summary class="flex items-center justify-between cursor-pointer px-6 py-4 bg-gray-50/80 hover:bg-indigo-50/50 transition-colors select-none list-none">
          <div class="flex items-center gap-3">
            <span class="inline-block px-3 py-1 bg-indigo-100 text-indigo-700 text-sm font-bold rounded-lg">{topic}</span>
            <span class="text-sm text-gray-400">({count} bài)</span>
          </div>
          <svg class="w-5 h-5 text-gray-400 transition-transform group-open/topic:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </summary>
        <div class="p-5 space-y-6">
          {levels.map(({ level, notes: levelNotes }) => (
            <section data-tag-group>
              {levels.length > 1 && (
                <h3 class="flex items-center gap-2 mb-3">
                  <span class={`px-2.5 py-0.5 rounded-md text-xs font-bold border ${LEVEL_STYLES[level] ?? LEVEL_STYLES['Khác']}`}>{level}</span>
                  <span class="text-xs text-gray-400">{levelNotes.length} bài</span>
                </h3>
              )}
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {levelNotes.map((note) => (
                  <a href={`${BASE}/notes/${note.slug}`} data-tags={JSON.stringify(note.data.tags)} class="block p-5 border border-indigo-50 rounded-2xl bg-indigo-50/30 hover:bg-indigo-50 hover:border-indigo-100 transition-all group">
                    <h4 class="text-lg font-bold text-gray-900 group-hover:text-indigo-600 transition-colors mb-2">{note.data.title}</h4>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">
                      <span>{note.data.date.toLocaleDateString('vi-VN')}</span>
                      {note.data.tags.slice(0, 3).map((t) => <span class="text-indigo-500/80">#{t}</span>)}
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </details>
    ))}
  </div>
</NotesLayout>
