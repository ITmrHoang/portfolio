---
import NotesLayout from '../../layouts/NotesLayout.astro';
import { getCollection } from 'astro:content';
import mdxComponents from '../../components/mdxComponents';
import { LEVEL_STYLES, noteTopic, readingTime } from '../../utils/site';

export async function getStaticPaths() {
  const entries = await getCollection('notes');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const components = mdxComponents;
const topic = noteTopic(entry);
---

<NotesLayout
  title={entry.data.title}
  currentSlug={entry.slug}
  description={`Ghi chú ${topic}${entry.data.level ? ` (${entry.data.level})` : ''}: ${entry.data.title}`}
  type="article"
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updatedDate}
  tags={entry.data.tags}
>
  <article class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-gray-100 h-full">
    <header class="mb-10 border-b border-gray-100 pb-8 text-center md:text-left">
      <div class="flex flex-wrap justify-center md:justify-start items-center gap-2 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-indigo-50 text-indigo-700">📁 {topic}</span>
        {entry.data.level && (
          <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold border ${LEVEL_STYLES[entry.data.level]}`}>📶 {entry.data.level}</span>
        )}
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-4 leading-tight">{entry.data.title}</h1>
      <div class="flex flex-wrap justify-center md:justify-start gap-x-4 gap-y-1 text-gray-500 font-medium">
        <time datetime={entry.data.date.toISOString()}>⏳ Đăng ngày: {entry.data.date.toLocaleDateString('vi-VN')}</time>
        {entry.data.updatedDate && <time datetime={entry.data.updatedDate.toISOString()}>🔄 Cập nhật: {entry.data.updatedDate.toLocaleDateString('vi-VN')}</time>}
        <span>📖 {readingTime(entry.body)} phút đọc</span>
      </div>
      {entry.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap justify-center md:justify-start gap-2">
          {entry.data.tags.map((t) => (
            <a href={`${base}/notes?tag=${encodeURIComponent(t)}`} class="px-2.5 py-0.5 rounded-full text-sm bg-gray-50 border border-gray-200 text-gray-600 hover:border-indigo-300 hover:text-indigo-600 transition-colors">#{t}</a>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-lg prose-indigo mx-auto md:mx-0 text-gray-800 max-w-none">
      <Content components={components} />
    </div>

    <footer class="mt-16 pt-8 border-t border-gray-100 flex items-center justify-between">
      <a href={`${base}/notes`} class="inline-flex items-center px-4 py-2 bg-gray-50 text-gray-700 rounded-xl hover:bg-indigo-50 hover:text-indigo-600 font-medium transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Trở về danh mục
      </a>
      <a href="#" class="inline-flex items-center px-4 py-2 text-gray-500 hover:text-indigo-600 transition-colors">
        Lên góc trên ↑
      </a>
    </footer>
  </article>
</NotesLayout>


