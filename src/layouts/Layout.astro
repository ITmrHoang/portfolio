---
import type { SeoProps } from '../components/BaseHead.astro';

interface Props extends SeoProps {
  enableRouter?: boolean;
}

import "../styles/global.css";
import "katex/dist/katex.min.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CurvedMagicMenu from "../components/CurvedMagicMenu.astro";
import AdSlot from "../components/AdSlot.astro";
import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/BaseHead.astro";
import { BUILD_ID } from "../consts";

const { enableRouter = false, ...seo } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const baseJson = JSON.stringify(base);
---

<!doctype html>
<html lang="vi">
  <head>
    <BaseHead {...seo} />
    {enableRouter && <ClientRouter />}
  </head>
  <body
    class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col"
  >
  <!-- Khi trang bị nhúng trong iframe (trang dự án), ẩn header/menu/footer cho gọn -->
  <script is:inline>
    if (window.self !== window.top) document.documentElement.classList.add("is-embedded");
  </script>
  <div class="progress-reading"></div>
    <!-- Navbar -->

    <Header />
    <CurvedMagicMenu />

    <!-- Main Layout Wrapper 3 Cột -->
    <div
      class="flex-grow w-full px-2 sm:px-4 2xl:px-8 flex flex-row justify-between"
    >
      <!-- Cột Trái chứa Quảng cáo (Dính sát viền trái màn hình) -->
      <aside
        class="hidden min-[1600px]:block w-[160px] 2xl:w-[250px] flex-shrink-0 py-10"
        data-pagefind-ignore
      >
        <AdSlot type="sidebar" />
      </aside>

      <!-- Nội dung chính (Tràn 100% khung giữa) -->
      <main class="flex-grow w-full py-8 sm:py-10 px-4 lg:px-6 pb-24 md:pb-10">
        <article id="article-page" class="w-full">
          <slot />
        </article>
      </main>

      <!-- Cột Phải chứa Quảng cáo (Dính sát viền phải màn hình) -->
      <aside
        class="hidden min-[1600px]:block w-[160px] 2xl:w-[250px] flex-shrink-0 py-10"
        data-pagefind-ignore
      >
        <AdSlot type="sidebar" />
      </aside>
    </div>

    <!-- Footer -->
    <Footer />

    <!-- Nút Cuộn lên đầu trang (Scroll to Top) -->
    <button
      data-pagefind-ignore
      id="scroll-to-top"
      class="fixed bottom-8 right-8 md:bottom-12 md:right-12 bg-indigo-600 text-white p-3 rounded-full shadow-2xl opacity-0 invisible hover:-translate-y-1 hover:bg-indigo-700 transition-all duration-300 z-50"
      title="Lên đầu trang"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg
      >
    </button>

    <style is:global>
      /* Trang đang được nhúng bằng iframe */
      html.is-embedded body > header,
      html.is-embedded body > footer,
      html.is-embedded .magic-nav,
      html.is-embedded body > div > aside,
      html.is-embedded #scroll-to-top {
        display: none !important;
      }
      html.is-embedded main {
        padding-bottom: 1rem;
      }

      /* CSS Animation cho tiêu đề Gradient */
      @keyframes gradient-move {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }
      .animate-gradient {
        background-size: 200% auto;
        animation: gradient-move 4s linear infinite;
      }
      .shadow-neon {
        box-shadow:
          0 0 15px rgba(99, 102, 241, 0.4),
          0 0 5px rgba(99, 102, 241, 0.2);
      }
    </style>

    <script is:inline define:vars={{ baseJson, appVersion: BUILD_ID }}>
      document.addEventListener("DOMContentLoaded", () => {
        // --- TÍNH NĂNG 0: GLOBAL BASE URL FIX for markdown ---
        // Tự động prepend base URL cho tất cả link nội bộ bắt đầu bằng /
        // Hoạt động trên cả GitHub Pages (/portfolio/) và deploy trực tiếp (/)
        // const getBase = {base}  // dùng được biến khi không phải is:inline astro bundle script
        const BASE = JSON.parse(baseJson);
        if (BASE) {
          document.querySelectorAll('a[href^="/"]').forEach((link) => {
            const href = link.getAttribute("href");
            if (href && !href.startsWith(BASE + "/") && href !== BASE) {
              link.setAttribute("href", BASE + href);
            }
          });
        }

        // --- TÍNH NĂNG 1: MAGIC BOTTOM NAVIGATION (MOBILE CURVED) ---
        const navItems = document.querySelectorAll(".magic-nav-item");
        const indicator = document.getElementById("magic-indicator");
        const currentPath = window.location.pathname;

        if (navItems.length > 0 && indicator) {
          // Bảng màu 5 Tabs (Hồng, Tím, Xanh ngọc, Xanh lá, Cam mờ)
          const tabColors = ["#ec4899", "#8b5cf6", "#06b6d4", "#10b981", "#f59e0b", "#f43f5e"];
          const navList = document.querySelector(".magic-nav-list");

          let activeItem =
            Array.from(navItems).find((item) => {
              const itemPath = item.getAttribute("data-path");
              return (
                (itemPath !== BASE + "/" && currentPath.includes(itemPath)) ||
                (itemPath === BASE + "/" &&
                  (currentPath === BASE + "/" || currentPath === BASE))
              );
            }) || navItems[0];

          const moveIndicator = (item) => {
            if (!item || !indicator) return;
            const itemRect = item.getBoundingClientRect();
            const parentRect = navList.getBoundingClientRect();

            // Dịch chuyển vòng tròn indicator
            indicator.style.transform = `translateX(${itemRect.left - parentRect.left}px)`;

            // Lấy Tab Index để đổi màu sinh động
            const index = Array.from(navItems).indexOf(item);
            navList.style.setProperty(
              "--active-color",
              tabColors[index % tabColors.length],
            );

            navItems.forEach((i) => i.classList.remove("active"));
            item.classList.add("active");
          };

          // Khởi tạo vị trí
          setTimeout(() => moveIndicator(activeItem), 100);

          navItems.forEach((item) => {
            item.addEventListener("click", () => moveIndicator(item));
          });
        }

        // --- TÍNH NĂNG 1.5: SEARCH BẮT SỰ KIỆN ENTER VÀ CLICK CHUỘT ---
        const searchInput = document.getElementById("desktop-search-input");
        const searchBtn = document.getElementById("desktop-search-btn");
        const mobileSearchInput = document.getElementById(
          "mobile-search-input",
        );
        const mobileSearchBtn = document.getElementById("mobile-search-btn");

        // Hàm xử lý search chung
        const executeSearch = (inputEl) => {
          const val = inputEl.value.trim();
          if (val !== "") {
            window.location.href =
              BASE + "/search?q=" + encodeURIComponent(val);
          } else {
            inputEl.focus(); // Nếu input rỗng thì focus mở rộng ra
          }
        };

        // Bắt sự kiện phím Enter
        const handleKeypress = (e) => {
          if (e.key === "Enter") executeSearch(e.target);
        };
        if (searchInput)
          searchInput.addEventListener("keypress", handleKeypress);
        if (mobileSearchInput)
          mobileSearchInput.addEventListener("keypress", handleKeypress);

        // Bắt sự kiện Click nút kính lúp
        if (searchBtn && searchInput) {
          searchBtn.addEventListener("click", () => executeSearch(searchInput));
        }
        if (mobileSearchBtn && mobileSearchInput) {
          mobileSearchBtn.addEventListener("click", () =>
            executeSearch(mobileSearchInput),
          );
        }

        // --- TÍNH NĂNG 2: SCROLL TO TOP ---
        const scrollBtn = document.getElementById("scroll-to-top");
        if (scrollBtn) {
          // Lắng nghe sự kiện cuộn chuột của toàn bộ trang window
          window.addEventListener("scroll", () => {
            // Nếu cuộn xuống quá 300px, hiển thị nút lên (xoá class tàng hình)
            if (window.scrollY > 300) {
              scrollBtn.classList.remove("opacity-0", "invisible");
              scrollBtn.classList.add("opacity-100", "visible");
            } else {
              scrollBtn.classList.add("opacity-0", "invisible");
              scrollBtn.classList.remove("opacity-100", "visible");
            }
          });
          // Bấm nút sẽ trigger hàm scrollTo vị trí y=0 (Đầu trang) kèm hiệu ứng mượt (smooth)
          scrollBtn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
          });
        }

        // --- TÍNH NĂNG 3: REGISTER SERVICE WORKER FOR PWA & CACHING ---
        // Mỗi lần build có mã phiên bản riêng (BUILD_ID). SW trả HTML từ cache trước,
        // nên trang có thể là bản cũ: hỏi SW phiên bản mới nhất, nếu trang cũ hơn thì
        // tự tải lại (khi người xem chưa thao tác gì) hoặc hiện thông báo "Tải lại".
        if ("serviceWorker" in navigator) {
          const swUrl = BASE ? `${BASE}/sw.js` : "/sw.js";
          const sw = navigator.serviceWorker;
          let interacted = false;
          ["pointerdown", "keydown", "wheel", "touchstart"].forEach((ev) =>
            window.addEventListener(ev, () => (interacted = true), { once: true, passive: true }),
          );

          const showUpdateToast = () => {
            if (document.getElementById("sw-update-toast")) return;
            const toast = document.createElement("div");
            toast.id = "sw-update-toast";
            toast.className =
              "fixed bottom-24 md:bottom-8 left-1/2 -translate-x-1/2 z-[60] flex items-center gap-3 bg-gray-900 text-white text-sm pl-5 pr-2 py-2 rounded-full shadow-2xl";
            toast.innerHTML =
              '<span>Đã có phiên bản mới</span><button class="px-3 py-1.5 rounded-full bg-indigo-500 hover:bg-indigo-400 font-semibold">Tải lại</button>';
            toast.querySelector("button").addEventListener("click", () => location.reload());
            document.body.appendChild(toast);
          };

          const onSwVersion = (swVersion) => {
            // Bỏ qua khi chạy dev (sw.js chưa được gắn mã) hoặc trang đã là bản mới nhất
            if (!swVersion || swVersion.startsWith("__") || !appVersion || swVersion <= appVersion) return;
            const key = "sw-reloaded-" + swVersion;
            let reloadedBefore = true;
            try {
              reloadedBefore = !!sessionStorage.getItem(key);
              sessionStorage.setItem(key, "1");
            } catch (e) {}
            // Chỉ tự tải lại 1 lần cho mỗi phiên bản để không bị lặp vô hạn
            if (!interacted && !reloadedBefore) location.reload();
            else showUpdateToast();
          };

          sw.addEventListener("message", (e) => {
            if (e.data && e.data.type === "VERSION") onSwVersion(e.data.version);
          });
          // SW mới vừa cài xong và tiếp quản trang -> hỏi lại phiên bản
          sw.addEventListener("controllerchange", () => sw.controller?.postMessage("GET_VERSION"));

          sw
            .register(swUrl, { scope: BASE ? `${BASE}/` : "/" })
            .then((reg) => {
              console.log("[PWA] Service Worker registered:", reg.scope, "| page version:", appVersion);
              sw.controller?.postMessage("GET_VERSION");
              // Tab mở lâu: mỗi khi quay lại tab thì kiểm tra có bản deploy mới không
              document.addEventListener("visibilitychange", () => {
                if (document.visibilityState === "visible") reg.update().catch(() => {});
              });
            })
            .catch((err) => {
              console.error("[PWA] Service Worker registration failed:", err);
            });
        }
      });
    </script>
  </body>
</html>
